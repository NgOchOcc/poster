% NeurIPS-inspired color theme for Gemini.
% This is an independent template and is not an official NeurIPS asset.

% ====================
% Definitions
% ====================

\definecolor{neuripsnavy}{HTML}{17152F}
\definecolor{neuripspurple}{HTML}{5B3FD0}
\definecolor{neuripsmagenta}{HTML}{D63B73}
\definecolor{neuripscoral}{HTML}{F26B5B}
\definecolor{neuripsorange}{HTML}{F3A83B}
\definecolor{neuripsink}{HTML}{242230}
\definecolor{neuripsmuted}{HTML}{625F70}
\definecolor{neuripslavender}{HTML}{F0EDFF}
\definecolor{neuripsrose}{HTML}{FFF0F3}
\definecolor{neuripswarm}{HTML}{FFF7E7}
\definecolor{neuripsrule}{HTML}{E3E0EA}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=neuripsink,bg=white}
\setbeamercolor{palette secondary}{fg=neuripsink,bg=white}
\setbeamercolor{palette tertiary}{fg=white,bg=neuripsnavy}
\setbeamercolor{palette quaternary}{fg=neuripsink,bg=white}
\setbeamercolor{structure}{fg=neuripspurple}
\setbeamercolor{normal text}{fg=neuripsink,bg=white}

% Headline and footer
\setbeamercolor{headline}{fg=white,bg=neuripsnavy}
\setbeamercolor{headline title}{fg=white}
\setbeamercolor{headline author}{fg=white}
\setbeamercolor{headline institute}{fg=neuripsrule}
\setbeamercolor{headline rule}{bg=neuripscoral}

% Standard block
\setbeamercolor{block title}{fg=neuripsnavy,bg=white}
\setbeamercolor{block separator}{bg=neuripspurple}
\setbeamercolor{block body}{fg=neuripsink,bg=white}

% Highlighted takeaway block
\setbeamercolor{block title alerted}{fg=neuripsnavy,bg=neuripsrose}
\setbeamercolor{block separator alerted}{bg=neuripscoral}
\setbeamercolor{block body alerted}{fg=neuripsink,bg=neuripsrose}

% Secondary highlighted block
\setbeamercolor{block title example}{fg=neuripsnavy,bg=neuripslavender}
\setbeamercolor{block separator example}{bg=neuripspurple}
\setbeamercolor{block body example}{fg=neuripsink,bg=neuripslavender}

% Details
\setbeamercolor{heading}{fg=neuripsmagenta}
\setbeamercolor{item}{fg=neuripspurple}
\setbeamercolor{caption name}{fg=neuripsmuted}
\setbeamercolor{caption}{fg=neuripsmuted}

% Bibliography
\setbeamercolor{bibliography item}{fg=neuripspurple}
\setbeamercolor{bibliography entry author}{fg=neuripsink}
\setbeamercolor{bibliography entry title}{fg=neuripsink}
\setbeamercolor{bibliography entry location}{fg=neuripsmuted}
\setbeamercolor{bibliography entry note}{fg=neuripsmuted}
